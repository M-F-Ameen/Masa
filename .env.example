# =============================================================================
# Qahwet Cairo Platform - Environment Configuration (.env)
# =============================================================================

# 1. Database Connection (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/resto_db"

# 2. JWT Authentication Secret (Must be at least 32 characters long)
# Generate a secure one via: openssl rand -base64 32
JWT_SECRET="replace_with_a_super_secure_random_jwt_secret_min_32_chars!"

# 3. Application Environment
# Options: development | production | test
NODE_ENV="production"
PORT=3000

# 4. Reverse Proxy Trust (Security / Rate Limiting)
# Number of reverse proxies in front of Next.js (e.g. 1 for Nginx or Cloudflare, 0 if exposed directly)
TRUSTED_PROXY_HOPS=1

# 5. Session Cookie Security (optional)
# Forces the Secure flag on session cookies. Leave unset to auto-detect from the
# request scheme (X-Forwarded-Proto). Set to "false" for plain HTTP deployments
# reachable by IP (e.g. http://192.168.1.183:1234), otherwise browsers drop the
# cookie and users get logged out on every navigation.
# COOKIE_SECURE="false"

# 6. Optional Initial Setup (Used when running 'npm run db:setup' for the first time)
INITIAL_ADMIN_PASSWORD="admin@password123"
RESTAURANT_NAME_AR="قهوة كايرو"
RESTAURANT_NAME_EN="Qahwet Cairo"
RESTAURANT_CURRENCY="EGP"
RESTAURANT_CURRENCY_SYMBOL="ج.م"
